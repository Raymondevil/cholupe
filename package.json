    "express-rate-limit": "^8.7.3",
    "express-session": "^1.19.0",
    "mime-types": "^2.1.35",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
